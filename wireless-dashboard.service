[Unit]
Description=Pi Wireless Dashboard
After=graphical.target
Wants=graphical.target

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
ExecStart=/usr/bin/python3 /home/pi/pi-wireless-dashboard/fancy_monitor.py
Restart=on-failure
RestartSec=5
User=pi

[Install]
WantedBy=graphical.target
